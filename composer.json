{
    "name": "nawasara/docs",
    "description": "In-app component gallery and code examples for the Nawasara UI library.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "livewire",
        "documentation",
        "component-gallery",
        "ui"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/docs/issues",
        "source": "https://github.com/nawasara/docs"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Docs\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "nawasara/ui": "*",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Docs\\DocsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
